{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"palette": [
				{
					"slug": "bg",
					"color": "#0c0f12",
					"name": "Background"
				},
				{
					"slug": "bg-elevated",
					"color": "#151a1f",
					"name": "Elevated"
				},
				{
					"slug": "ink",
					"color": "#f2efe8",
					"name": "Ink"
				},
				{
					"slug": "muted",
					"color": "#9aa3ad",
					"name": "Muted"
				},
				{
					"slug": "accent",
					"color": "#c4a35a",
					"name": "Accent"
				},
				{
					"slug": "accent-ink",
					"color": "#0c0f12",
					"name": "Accent Ink"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "\"Cormorant Garamond\", \"Times New Roman\", serif",
					"name": "Display",
					"slug": "display",
					"fontFace": [
						{
							"fontFamily": "Cormorant Garamond",
							"fontWeight": "500 600",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"https://fonts.gstatic.com/s/cormorantgaramond/v16/co3YmX5slCNuHLi8bLeY9MK7whWMhyjQAllf.woff2"
							]
						}
					]
				},
				{
					"fontFamily": "\"DM Sans\", \"Segoe UI\", sans-serif",
					"name": "Body",
					"slug": "body",
					"fontFace": [
						{
							"fontFamily": "DM Sans",
							"fontWeight": "400 600",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"https://fonts.gstatic.com/s/dmsans/v15/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAopxhTg.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "1.375rem",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "2rem",
					"name": "Extra Large"
				},
				{
					"slug": "xx-large",
					"size": "clamp(2.5rem, 6vw, 4rem)",
					"name": "2X Large"
				}
			]
		},
		"spacing": {
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{
					"slug": "30",
					"size": "0.75rem",
					"name": "1"
				},
				{
					"slug": "40",
					"size": "1rem",
					"name": "2"
				},
				{
					"slug": "50",
					"size": "1.5rem",
					"name": "3"
				},
				{
					"slug": "60",
					"size": "2.5rem",
					"name": "4"
				},
				{
					"slug": "70",
					"size": "4rem",
					"name": "5"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--bg)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.55"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				":hover": {
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"lineHeight": "1.15"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--accent-ink)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "600"
				},
				"border": {
					"radius": "0"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			}
		},
		"spacing": {
			"padding": {
				"top": "0",
				"right": "var(--wp--preset--spacing--40)",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--40)"
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-booking",
			"title": "Booking",
			"postTypes": ["page"]
		}
	]
}
